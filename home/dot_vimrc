set nocompatible

" Plugins — list lives in ~/.vim/plugins.vim (chezmoi reinstalls on change)
call plug#begin('~/.vim/plugged')
source ~/.vim/plugins.vim
call plug#end()

filetype plugin indent on
" tmux-256color terminfo omits the background-query capability vim uses to
" auto-detect light/dark, so under tmux vim falls back to background=light and
" loads the light variant of the default colorscheme (dark blue/brown) onto
" Ghostty's dark background. Pin it so colors match in and out of tmux.
set background=dark
syntax on
set number relativenumber            " hybrid line numbers
set hidden                           " switch buffers without saving
set incsearch hlsearch ignorecase smartcase
set scrolloff=5
set mouse=a
set splitright splitbelow
set wildmenu
set termguicolors                    " 24-bit color
" Truecolor under tmux: tmux-256color terminfo doesn't advertise RGB, so Vim
" needs the set-foreground/background sequences spelled out explicitly.
let &t_8f = "\<Esc>[38;2;%lu;%lu;%lum"
let &t_8b = "\<Esc>[48;2;%lu;%lu;%lum"
set clipboard=unnamed                " yank -> Mac pasteboard (host-local)

let mapleader = " "                  " leader = Space

" Hotkeys below are kept identical to ~/.config/nvim/lua/config/keymaps.lua so
" muscle memory carries between vim and neovim. Change one, change both.

" NOTE: never put a trailing " comment on a :map line -- vim takes the whole
" rest of the line as the {rhs}, so the comment text gets replayed as
" keystrokes after the mapping fires. Comments go above the mapping.

" fzf (uses ripgrep + fd)
let $FZF_DEFAULT_COMMAND = 'fd --type f --hidden --follow --exclude .git'
" F/B/W/Q rather than f/b/w/q: neovim's LazyVim owns a menu under each of those
" lowercase letters, so the shifted keys are what can be identical in both
" editors. See ~/.config/nvim/lua/config/keymaps.lua.
nnoremap <leader>F :Files<CR>
nnoremap <leader>B :Buffers<CR>
" Override fzf.vim's stock :Rg to search dotfiles too (--hidden), keeping .git
" out. Without this, grep would silently skip files the picker happily lists,
" since $FZF_DEFAULT_COMMAND above already passes --hidden. Same behaviour as
" neovim's Snacks grep -- see ~/.config/nvim/lua/plugins/snacks.lua.
" Base command copied from fzf.vim's own definition, plus the two flags.
command! -bang -nargs=* Rg
      \ call fzf#vim#grep(
      \   "rg --column --line-number --no-heading --color=always --smart-case --hidden --glob '!.git' -- "
      \     .fzf#shellescape(<q-args>),
      \   fzf#vim#with_preview(), <bang>0)

" search file contents across the project
nnoremap <leader>/ :Rg<CR>
nnoremap <leader>l :BLines<CR>
" recently opened files
nnoremap <leader>r :History<CR>
" git-tracked files
nnoremap <leader>G :GFiles<CR>

" Find files including gitignored ones (--no-ignore) -- for .env-style files
" that are deliberately ignored but still need editing. fzf.vim has no runtime
" toggle, so this is a separate command; neovim's twin is <leader>I, which also
" has an in-picker <a-i> toggle.
command! -bang -nargs=? -complete=dir FilesAll
      \ call fzf#vim#files(<q-args>,
      \   fzf#vim#with_preview({'source': 'fd --type f --hidden --no-ignore --follow --exclude .git'}),
      \   <bang>0)
nnoremap <leader>I :FilesAll<CR>

" NERDTree
nnoremap <leader>e :NERDTreeToggle<CR>
" reveal the current file in the tree
nnoremap <leader>E :NERDTreeFind<CR>
let NERDTreeShowHidden = 1
autocmd BufEnter * if winnr('$') == 1 && exists('b:NERDTree') && b:NERDTree.isTabTree() | quit | endif

" OSC52: every yank also goes to the client clipboard over SSH
autocmd TextYankPost * if v:event.operator is 'y' && v:event.regname is ''
      \ | call OSCYankRegister('"') | endif
vnoremap <leader>y :OSCYankVisual<CR>

" Window navigation
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" Quality of life
nnoremap <leader>W :w<CR>
nnoremap <leader>Q :q<CR>
nnoremap <silent> <esc><esc> :nohlsearch<CR>

" Cheat sheet (glow in :term split; q closes via ++close).
" expand() resolves ~ — vim's :term passes argv literally and won't do it.
" env TERM=tmux-256color: vim's :term otherwise forces TERM=xterm-256color,
" which breaks tmux's truecolor passthrough for the nested glow and down-samples
" its colors to 256. Matching the TERM that glow sees when run directly in tmux
" (where the tmux cheatsheet renders correctly) restores truecolor.
nnoremap <leader>? :execute 'vert term ++close env TERM=tmux-256color glow -p ' . expand('~/cheatsheets/vim/general.md')<CR>
