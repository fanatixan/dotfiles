{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env sh

{{ $role := .role -}}
{{ $workstation := eq .role "workstation" -}}
{{ $brews := list -}}
{{ $taps := list -}}
{{ $casks := list -}}
{{ $apps := list -}}
{{ range .packages -}}
  {{ $pkg := . -}}
  {{ if eq "string" (printf "%T" .) -}}
    {{ $pkg = dict "name" . -}}
  {{ end -}}
  {{ if hasKey $pkg "cask" -}}
    {{ if $workstation }}{{ $casks = append $casks $pkg.cask }}{{ end -}}
  {{ else if hasKey $pkg "mas" -}}
    {{ if $workstation }}{{ $apps = append $apps $pkg }}{{ end -}}
  {{ else if or (not (hasKey $pkg "roles")) (has $role $pkg.roles) -}}
    {{ if hasKey $pkg "tap" -}}
      {{ $taps = append $taps $pkg.tap -}}
      {{ $brews = append $brews (printf "%s/%s" $pkg.tap $pkg.name) -}}
    {{ else if hasKey $pkg "brew" -}}
      {{ $brews = append $brews $pkg.brew -}}
    {{ else if not (or (hasKey $pkg "apt") (hasKey $pkg "apk") (hasKey $pkg "cargo") (hasKey $pkg "linuxCommand")) -}}
      {{ $brews = append $brews $pkg.name -}}
    {{ end -}}
  {{ end -}}
{{ end -}}

brew_config_path=$HOME/.dotfiles/homebrew
brewfile_path=$brew_config_path/Brewfile

# Homebrew only loads formulae from trusted third-party taps
{{ range uniq $taps -}}
brew tap {{ . }} && { brew trust --tap {{ . }} || true; }
{{ end }}
mkdir -p $brew_config_path
cat > $brewfile_path <<EOF
{{ range uniq $taps -}}
tap {{ . | quote }}
{{ end -}}
{{ range $brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range $casks -}}
cask {{ . | quote }}
{{ end -}}
{{ range $apps -}}
mas {{ .name | quote }}, id: {{ .mas }}
{{ end -}}
EOF

brew bundle --file=$brewfile_path
{{ end -}}
