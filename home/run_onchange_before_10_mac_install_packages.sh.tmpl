{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env sh

{{ $role := .role -}}
brew_config_path=$HOME/.dotfiles/homebrew
brewfile_path=$brew_config_path/Brewfile

mkdir -p $brew_config_path
cat > $brewfile_path <<EOF
{{ range .packages.unixLike -}}
  {{- if eq "string" (printf "%T" .) -}}
brew {{ . | quote }}
  {{- else if and (hasKey . "roles") (not (has $role .roles)) -}}
  {{- else if (hasKey . "brew") -}}
brew {{ .brew | quote }}
  {{- else if not (or (hasKey . "apt") (hasKey . "apk") (hasKey . "cargo") (hasKey . "linuxCommand")) -}}
brew {{ .name | quote }}
  {{- end }}
{{ end -}}
{{- range .packages.macos.brews -}}
brew {{ . | quote }}
{{ end -}}
{{- if eq .role "workstation" -}}
{{- range .packages.macos.casks -}}
cask {{ . | quote }}
{{ end -}}
{{- range .packages.macos.appstore -}}
mas {{ .name | quote }}, id: {{ .id }}
{{ end }}
{{- end }}
EOF

brew bundle --file=$brewfile_path
{{ end -}}
