{{- define "install" -}}
  {{ if and (lookPath "brew") (hasKey . "brew") -}}
    {{ if hasKey . "tap" -}}
    brew tap {{ .tap }} && { brew trust --tap {{ .tap }} || true; }
    {{ end -}}
    brew install {{ .brew }}
  {{ else if and (lookPath "apt") (hasKey . "apt") -}}
    sudo apt install -y {{ .apt }}
  {{ else if and (lookPath "apk") (hasKey . "apk") -}}
    sudo apk add {{ .apk }}
  {{ else if (hasKey . "linuxCommand") -}}
    {{ .linuxCommand }}
  {{ else if and (lookPath "cargo") (hasKey . "cargo") -}}
    command -v {{ .name }} 2>&1 >/dev/null || cargo install {{ .cargo }}
  {{ else -}}
    echo "Couldn't install {{ .name }}"
  {{ end -}}
{{ end -}}

{{ if and (eq .chezmoi.os "linux") (ne .role "agent") -}}
#!/usr/bin/env sh

{{ $role := .role -}}

{{ range .packages -}}
  {{ $pkg := . -}}
  {{ if eq "string" (printf "%T" .) -}}
    {{ $pkg = dict "name" . -}}
  {{ end -}}
  {{ if and (hasKey $pkg "name") (not (hasKey $pkg "cask")) (not (hasKey $pkg "mas")) -}}
  {{ if or (not (hasKey $pkg "roles")) (has $role $pkg.roles) -}}
    {{ if hasKey $pkg "tap" -}}
      {{ $pkg = merge (dict "brew" (printf "%s/%s" $pkg.tap $pkg.name)) $pkg -}}
    {{ else if not (or (hasKey $pkg "brew") (hasKey $pkg "apt") (hasKey $pkg "apk") (hasKey $pkg "cargo") (hasKey $pkg "linuxCommand")) -}}
      {{ $pkg = merge (dict "brew" $pkg.name "apt" $pkg.name "apk" $pkg.name "cargo" $pkg.name) $pkg -}}
    {{ end -}}
    {{ template "install" $pkg }}
  {{ end -}}
  {{ end -}}
{{ end -}}
{{ end -}}
