[init]
	defaultBranch = main

[core]
	editor = vim
	autocrlf = input
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true

[user]
{{- if eq .role "agent" }}
	# box-only key, generated on the Citadel box and registered on GitHub as a signing key
	signingkey = ~/.ssh/id_ed25519_signing.pub
{{- else }}
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHlr3NBIFhX1/GtnLT9QQtL+8fIvBSvSzEoHf3LMR2Li
{{- end }}
	name = Attila-Fejer
	email = attila@fejer.io
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	gpgsign = true

[push]
	autoSetupRemote = true
[pull]
	rebase = true
[rebase]
	updateRefs = true
[merge]
	conflictsyle = zdiff3
[submodule]
	recurse = true

[include]
	path = ~/project/.gitconfig

# Galvanize host config
[includeIf "hasconfig:remote.*.url:https://gitlab.galvanize.com/**"]
	path = ~/.dotfiles/git/hosts/gitlab.galvanize.com.gitconfig

[includeIf "hasconfig:remote.*.url:git@ssh.gitlab.galvanize.com:*/**"]
	path = ~/.dotfiles/git/hosts/gitlab.galvanize.com.gitconfig

# Toptal host config
[includeIf "hasconfig:remote.*.url:https://git.toptal.com/**"]
	path = ~/.dotfiles/git/hosts/git.toptal.com.gitconfig

[includeIf "hasconfig:remote.*.url:git@git.toptal.com:*/**"]
	path = ~/.dotfiles/git/hosts/git.toptal.com.gitconfig

{{ if or (lookPath "git-lfs") (has .role (list "worker" "agent")) -}}
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
{{ end -}}
