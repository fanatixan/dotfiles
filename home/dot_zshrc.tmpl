setopt CSH_NULL_GLOB

source $HOME/.shellrc

# byte-order glob, as on macOS: glibc locales (en_US.UTF-8) ignore the _ of
# _zsh, which then loads after the folders that need its functions
dotfiles_list() {
  local LC_ALL=C
  reply=($DOTFILES_FOLDER/**/$1(N))
}

source_all_dotfiles() {
  local reply f
  dotfiles_list $1
  for f in $reply; do
    source $f
  done
}

{{ if eq .chezmoi.os "linux" -}}
# the env phase already ran in .zshenv (once per session)
{{- else -}}
source_all_dotfiles paths
{{- end }}

if is_interactive; then
  source_all_dotfiles completion.sh
  source_all_dotfiles completion.zsh
  source_all_dotfiles before_rc.sh
  source_all_dotfiles before_rc.zsh
  source_all_dotfiles rc.sh
  source_all_dotfiles rc.zsh
  source_all_dotfiles after_rc.sh
  source_all_dotfiles after_rc.zsh
  source_all_dotfiles aliases
  source_all_dotfiles functions.sh
  source_all_dotfiles functions.zsh
fi
