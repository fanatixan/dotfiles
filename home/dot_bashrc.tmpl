{{ if eq .chezmoi.os "linux" -}}
# A non-interactive bash that inherited the env phase has nothing to load:
# return before defining anything, so scripts stay clean.
case $- in
  *i*) ;;
  *) [ -n "${DOTFILES_ENV_LOADED:-}" ] && return ;;
esac

{{ end -}}
source $HOME/.shellrc

source_all_dotfiles() {
  local filename=$1 f files restore
  # glob options only while listing, so they don't leak into the shell
  restore=$(shopt -p nullglob globstar 2>/dev/null)
  shopt -s nullglob globstar 2>/dev/null
  files=($DOTFILES_FOLDER/**/$filename)
  eval "$restore"
  for f in "${files[@]}"
  do
    source $f
  done
}

{{ if eq .chezmoi.os "linux" -}}
# env phase: once per session, children inherit it (same guard as .zshenv)
if [ -z "${DOTFILES_ENV_LOADED:-}" ]; then
  source_all_dotfiles paths
  export DOTFILES_ENV_LOADED=1
fi
{{- else -}}
source_all_dotfiles paths
{{- end }}

if is_interactive; then
  source_all_dotfiles completion.sh
  source_all_dotfiles completion.bash
  source_all_dotfiles before_rc.sh
  source_all_dotfiles before_rc.bash
  source_all_dotfiles rc.sh
  source_all_dotfiles rc.bash
  source_all_dotfiles after_rc.sh
  source_all_dotfiles after_rc.bash
  source_all_dotfiles aliases
  source_all_dotfiles functions.sh
  source_all_dotfiles functions.bash
fi
