{{ if and (eq .chezmoi.os "linux") (ne .role "agent") -}}
#!/usr/bin/env sh

# no confirmation per package (Homebrew 7 asks by default in a terminal)
export HOMEBREW_NO_ASK=1

if ! command -v zsh >/dev/null 2>&1; then
  if command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update
    sudo apt-get install -y zsh
  elif command -v apk >/dev/null 2>&1; then
    sudo apk add zsh
  elif command -v brew >/dev/null 2>&1; then
    brew install zsh
  else
    echo "Couldn't install zsh"
  fi
fi
{{- if eq .role "worker" }}

# zsh as the login shell, so SSH commands, su and tools that start $SHELL
# (Claude Code) load .zshenv; usermod needs no password prompt, unlike chsh
zsh_path=$(command -v zsh)
if [ "$(getent passwd "$(id -un)" | cut -d: -f7)" != "$zsh_path" ]; then
  grep -qx "$zsh_path" /etc/shells || echo "$zsh_path" | sudo tee -a /etc/shells >/dev/null
  sudo usermod -s "$zsh_path" "$(id -un)"
fi
{{- end }}

{{ end -}}
